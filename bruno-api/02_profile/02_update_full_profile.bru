meta {
  name: 02_update_full_profile
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/profile/details
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "first_name": "firstname",
    "last_name": "lastname",
    "email": "admin@matcha.com",
    "date_of_birth": "2025-01-01T00:00:00.000Z",
    "gender": "male",
    "sexual_preference": "both",
    "biography": "test biography",
    "interests": [
      "testing",
      "1",
      "2",
      "3"
    ]
  }
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: false
  timeout: 10000
}
