meta {
  name: 04_get_profile_picture
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/profile/profilepic
  auth: inherit
}

tests {
  test("status 200", function() {
    expect(res.getBody().picture.image_url).to.equal(bru.getVar("profilePicUrl"))
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: false
  timeout: 10000
}
