meta {
  name: 07_get_pictures
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/profile/pictures
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  picture: @file(test_image.png)
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().pictures[0].image_url).to.equal(bru.getVar("pictureUrl"));
  });
}

settings {
  encodeUrl: false
  timeout: 10000
}
