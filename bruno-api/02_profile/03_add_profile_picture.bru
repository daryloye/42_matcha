meta {
  name: 03_add_profile_picture
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/profile/profilepic
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  picture: @file(test_image.png)
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

script:post-response {
  const body = res.getBody();
  bru.setVar("profilePicUrl", body.picture.image_url);
}

settings {
  encodeUrl: false
  timeout: 10000
}
