meta {
  name: 04_get_pictures
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/profile/pictures
  auth: inherit
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

script:post-response {
  const body = res.getBody();
  const pictures = body.pictures || [];

  if (!pictures.length) {
    throw new Error('No pictures found');
  }

  const pictureId = pictures[1].id;
  bru.setVar('pictureId', pictureId);
}

settings {
  encodeUrl: false
  timeout: 10000
}
