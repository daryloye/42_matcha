meta {
  name: 06_add_picture
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/profile/pictures
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  picture: @file(test_image.png)
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

script:post-response {
  const body = res.getBody();
  bru.setVar("pictureUrl", body.picture.image_url);
  bru.setVar("pictureId", body.picture.id);
}

settings {
  encodeUrl: false
  timeout: 10000
}
